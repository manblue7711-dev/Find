# Copy to .env for docker compose. Never commit the real .env.
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# Photos (Cloudinary)
CLOUDINARY_CLOUD_NAME=

# AI photo and question checks (console.anthropic.com). Without it, posting is refused.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# SMS (Arkesel). Needed for password reset codes and alerts.
ARKESEL_API_KEY=
ARKESEL_SENDER=

# false = skip the SMS code at sign-up (use until your sender ID is approved)
REQUIRE_PHONE_VERIFY=false
